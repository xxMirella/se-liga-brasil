# Server-only configuration. Copy locally; never commit populated credentials.
DATABASE_URL=
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=
SE_LIGA_BRASIL_IDENTITY_KEY=
# Legacy SUPABASE_URL accepts a PostgreSQL DSN OR an HTTPS project endpoint.
SUPABASE_URL=
# Tests use an isolated ephemeral PostgreSQL database, never production.
TEST_DATABASE_URL=
SE_LIGA_BRASIL_TEST_ENV_FILE=
# Public SEO origin; default: https://seligabrasil.gov. Never use the request Host header.
PUBLIC_SITE_URL=
# Preview/development Vercel environments are noindex regardless of this flag.
SEARCH_INDEXING_ENABLED=
# Optional token issued by Google Search Console for HTML verification.
GOOGLE_SITE_VERIFICATION=
# Platform-provided on Vercel; leave empty locally.
VERCEL_ENV=
